# Copia este archivo a .env y ajusta los valores. El archivo .env no se sube al repositorio.
# Con docker compose no es obligatorio: sin .env se usan valores de desarrollo.

# --- Django ---
# Clave secreta. En producción debe ser larga, aleatoria y distinta de la de desarrollo.
DJANGO_SECRET_KEY=cambia-esta-clave
# true solo en desarrollo; en producción, false
DJANGO_DEBUG=true
# Dominios desde los que se puede acceder, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos PostgreSQL ---
POSTGRES_DB=agrogmao
POSTGRES_USER=agrogmao
POSTGRES_PASSWORD=cambia-esta-contrasena
# Con docker compose el servidor de base de datos se llama db (ya está configurado).
# Si ejecutas Django fuera de Docker, usa localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
